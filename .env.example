# -----------------------------------------------------------------------------
# ReEdit environment
# Copy to .env.local for development. On Vercel, set these in Project Settings.
# -----------------------------------------------------------------------------

# Supabase
# Local: run `npm run db:start` (or `npm run db:status`) and copy the values
# it prints. Hosted: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SECRET_KEY=

# Google sign-in, local only: the OAuth client secret, read by the Supabase CLI
# from this file (restart with `npm run db:stop && npm run db:start`). The client
# ID is in supabase/config.toml. Hosted: Supabase → Authentication → Providers → Google.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Public URL of the app (used in email links).
# Production: https://app.foundrymedia.co
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Email via Brevo (new leads and applicants, invitations, replies to clients,
# and notification emails). Brevo → SMTP & API → API keys. The sender address
# must be a verified sender or domain in Brevo.
# Locally, Mailpit (below) takes precedence while MAILPIT_URL is set, so dev and
# tests never email real people. In Brevo, turn off IP blocking under Security →
# Authorised IPs: Vercel and Supabase send from changing addresses.
BREVO_API_KEY=
EMAIL_FROM="ReEdit <no-reply@foundrymedia.co>"

# Development only: deliver every email to the local Mailpit inbox
# (http://127.0.0.1:54324), even with a Brevo key set. Leave unset in production.
MAILPIT_URL=http://127.0.0.1:54324

# Shared secret for /api/jobs/notifications, which the database's scheduled job
# calls to send notification emails. Use a long random value, and store the same
# one in Supabase Vault as foundry_jobs_secret (see README → Deployment).
# Locally it can stay empty: seed.sql sets up a development secret.
JOBS_SECRET= 8e485548-36d5-4957-a17f-61923f614827
